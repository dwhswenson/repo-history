{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-history-tracking:viz-summary:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "display_name": {
      "type": "string",
      "pattern": "\\S"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:repo-history-tracking:common:1#/$defs/repository"
      }
    },
    "actors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "enum": [
          "human",
          "bot",
          "unlinked_git"
        ]
      }
    },
    "months": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "urn:repo-history-tracking:common:1#/$defs/calendar"
          },
          "summaries": {
            "$ref": "urn:repo-history-tracking:common:1#/$defs/summaries"
          },
          "source_reports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "metadata": {
                  "$ref": "urn:repo-history-tracking:common:1#/$defs/monthly_metadata"
                },
                "summaries": {
                  "$ref": "urn:repo-history-tracking:common:1#/$defs/summaries"
                }
              },
              "required": [
                "metadata",
                "summaries"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "metadata",
          "summaries",
          "source_reports"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "display_name",
    "repositories",
    "actors",
    "months"
  ],
  "additionalProperties": false
}
