{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-history-tracking:common:1",
  "$defs": {
    "collection_run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "enum": [
            "backfill",
            "update",
            "collect_history",
            "collect_month",
            "manual"
          ]
        },
        "mode": {
          "enum": [
            "rebuild",
            "incremental"
          ]
        },
        "collector_version": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "collection_since": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive historical lower collection bound; null means unbounded. Observation time is recorded separately."
        },
        "collection_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exclusive historical upper collection bound; null means unbounded."
        },
        "requested_start_month": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_end_month": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_discovery": {
          "anyOf": [
            {
              "enum": [
                "full",
                "bounded",
                "incremental"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_history": {
          "anyOf": [
            {
              "enum": [
                "full",
                "bounded",
                "incremental"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "command",
        "mode",
        "collector_version",
        "started_at",
        "finished_at",
        "collection_since",
        "collection_until",
        "requested_start_month",
        "requested_end_month",
        "parent_discovery",
        "commit_history"
      ],
      "additionalProperties": false,
      "description": "Immutable collection facts. A run UUID always identifies the same descriptor. Collection bounds describe traversal; requested month bounds describe output selection."
    },
    "repository": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "history_start_month": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Earliest established history month, including repository creation and imported older activity; null means unknown, never implicit zero."
        },
        "history_start_established_by": {
          "anyOf": [
            {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/collection_run"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full-history rebuild that established the retained boundary; required together with history_start_month."
        }
      },
      "required": [
        "node_id",
        "full_name",
        "url",
        "created_at",
        "history_start_month",
        "history_start_established_by"
      ],
      "additionalProperties": false
    },
    "monthly_metadata": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "urn:repo-history-tracking:common:1#/$defs/repository"
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "month_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "month_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ongoing": {
          "type": "boolean"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "created_by": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/collection_run"
            },
            "last_updated_by": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/collection_run"
            },
            "last_rebuilt_by": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/collection_run"
            }
          },
          "required": [
            "created_by",
            "last_updated_by",
            "last_rebuilt_by"
          ],
          "additionalProperties": false,
          "description": "Only original creation, latest refresh, and latest rebuild are retained. Intermediate runs can be retained in version control."
        },
        "coverage": {
          "type": "object",
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "as_of",
            "limitations"
          ],
          "additionalProperties": false,
          "description": "Observation facts about the resulting data. as_of is not a transactional snapshot or a promise that historical records cannot change."
        },
        "default_branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "default_branch_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "month",
        "month_start",
        "month_end",
        "ongoing",
        "provenance",
        "coverage",
        "default_branch",
        "default_branch_head"
      ],
      "additionalProperties": false
    },
    "calendar": {
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "month_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "month_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ongoing": {
          "type": "boolean"
        }
      },
      "required": [
        "month",
        "month_start",
        "month_end",
        "ongoing"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pr_opened": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pr_merged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issue_opened": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issue_closed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issue_reopened": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issue_comment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pr_conversation_comment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pr_inline_review_comment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pr_review": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "commit",
        "pr_opened",
        "pr_merged",
        "issue_opened",
        "issue_closed",
        "issue_reopened",
        "issue_comment",
        "pr_conversation_comment",
        "pr_inline_review_comment",
        "pr_review"
      ],
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "human": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved_git": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "human",
        "bot",
        "unresolved_git"
      ],
      "additionalProperties": false
    },
    "summaries": {
      "type": "object",
      "properties": {
        "repository_counts": {
          "$ref": "urn:repo-history-tracking:common:1#/$defs/counts"
        },
        "actor_counts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "urn:repo-history-tracking:common:1#/$defs/counts"
          }
        },
        "distinct_actors": {
          "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
        },
        "distinct_actors_by_type": {
          "type": "object",
          "properties": {
            "commit": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "pr_opened": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "pr_merged": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "issue_opened": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "issue_closed": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "issue_reopened": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "issue_comment": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "pr_conversation_comment": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "pr_inline_review_comment": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            },
            "pr_review": {
              "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
            }
          },
          "required": [
            "commit",
            "pr_opened",
            "pr_merged",
            "issue_opened",
            "issue_closed",
            "issue_reopened",
            "issue_comment",
            "pr_conversation_comment",
            "pr_inline_review_comment",
            "pr_review"
          ],
          "additionalProperties": false
        },
        "unattributed_total": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed_by_type": {
          "$ref": "urn:repo-history-tracking:common:1#/$defs/counts"
        }
      },
      "required": [
        "repository_counts",
        "actor_counts",
        "distinct_actors",
        "distinct_actors_by_type",
        "unattributed_total",
        "unattributed_by_type"
      ],
      "additionalProperties": false
    }
  }
}
