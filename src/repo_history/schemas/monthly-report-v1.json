{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-history-tracking:monthly-report:1",
  "title": "Monthly repository activity report v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "summaries": {
      "$ref": "#/$defs/summaries"
    }
  },
  "required": [
    "schema_version",
    "metadata",
    "actors",
    "activities",
    "summaries"
  ],
  "additionalProperties": false,
  "$defs": {
    "actor": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "human",
            "bot",
            "unresolved_git"
          ]
        },
        "github_node_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "database_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "login": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "classification",
        "github_node_id",
        "database_id",
        "login",
        "display_name",
        "url",
        "git_name",
        "git_email"
      ],
      "additionalProperties": false
    },
    "git_identity": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "email",
        "actor_key"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "$ref": "urn:repo-history-tracking:common:1#/$defs/monthly_metadata"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "commit",
            "issue",
            "pull_request"
          ]
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "pattern": "^[^\\r\\n]*$"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "author_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "node_id",
        "title",
        "url",
        "number",
        "author_key"
      ],
      "additionalProperties": false
    },
    "credit": {
      "type": "object",
      "properties": {
        "actor_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "author",
            "co_author",
            "merger",
            "closer",
            "reopener"
          ]
        }
      },
      "required": [
        "actor_key",
        "role"
      ],
      "additionalProperties": false
    },
    "counts": {
      "$ref": "urn:repo-history-tracking:common:1#/$defs/counts"
    },
    "population": {
      "$ref": "urn:repo-history-tracking:common:1#/$defs/population"
    },
    "summaries": {
      "$ref": "urn:repo-history-tracking:common:1#/$defs/summaries"
    },
    "commit_metadata": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authored_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "committer": {
          "$ref": "#/$defs/git_identity"
        },
        "parent_shas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      },
      "required": [
        "sha",
        "authored_at",
        "committer",
        "parent_shas"
      ],
      "additionalProperties": false
    },
    "commit_activity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "commit"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "credits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credit"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/commit_metadata"
        }
      },
      "required": [
        "id",
        "type",
        "occurred_at",
        "url",
        "subject",
        "credits",
        "metadata"
      ],
      "additionalProperties": false
    },
    "pr_opened_metadata": {
      "type": "object",
      "properties": {
        "source_node_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_node_id"
      ],
      "additionalProperties": false
    },
    "pr_opened_activity": {
