          "pattern": "Z$"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "credits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credit"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/commit_metadata"
        }
      },
      "required": [
        "id",
        "type",
        "occurred_at",
        "url",
        "subject",
        "credits",
        "metadata"
      ],
      "additionalProperties": false
    },
