{
  "name": "@dwhswenson/repo-history-viz",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode standalone && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.html README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html README.md",
    "build:demo": "tsc && vite build",
    "prepack": "npm run build",
    "pretest:browser": "npm run build && npm run build:demo",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run format:check && npm test && npm run test:package"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chart.js": "^4.5.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "description": "Embeddable web component for monthly GitHub repository activity and contributor trends",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/types/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/types/index.d.ts",
    "dist/types/register.d.ts",
    "dist/types/component.d.ts",
    "dist/types/report.d.ts",
    "dist/THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/repo-history-viz.js",
    "./src/register.ts"
  ],
  "author": "David W.H. Swenson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwhswenson/repo-history.git",
    "directory": "repo-history-viz"
  },
  "homepage": "https://github.com/dwhswenson/repo-history/tree/main/repo-history-viz#readme",
  "bugs": {
    "url": "https://github.com/dwhswenson/repo-history/issues"
  },
  "keywords": [
    "github",
    "repository-history",
    "web-component",
    "visualization",
    "contributors"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
