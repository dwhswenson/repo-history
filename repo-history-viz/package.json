{
  "name": "repo-history-viz",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode standalone && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.html README.md",
    "format:check": "prettier --check src tests *.ts *.json *.html README.md",
    "build:demo": "tsc && vite build",
    "prepack": "npm run build",
    "pretest:browser": "npm run build && npm run build:demo"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chart.js": "^4.5.1"
  },
  "description": "Embeddable web component for monthly GitHub repository activity and contributor trends",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/types/register.d.ts",
      "import": "./dist/repo-history-viz.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "sideEffects": [
    "./dist/repo-history-viz.js",
    "./src/register.ts"
  ]
}
